<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_Safety" Id="{cf88dd38-b736-4d97-b024-1f3ef90e1e6e}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // Operator / HMI / sequence commands
    bEStop1_ResetCmd     : BOOL;   // Momentary reset request from HMI/button
    bSafety_ErrAckCmd    : BOOL;   // Momentary error acknowledge request

    // Rising-edge outputs mapped to TwinSAFE standard aliases
    bEStop1_RestartOut   : BOOL;   // Linked to EStop1_Restart.sds
    bSafety_ErrAckOut    : BOOL;   // Linked to ErrorAcknowledgement.sds

    // Safety status & diagnostics
    bEStop1_SafeHealthy  : BOOL;   // TRUE when E-Stop safe output is healthy
    bEStop1_Tripped      : BOOL;   // TRUE when E-Stop safe output is open/tripped
    bSafety_GroupRun     : BOOL;   // TwinSAFE group run state
    bSafety_ComFault     : BOOL;   // Safety communication / group fault status
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>